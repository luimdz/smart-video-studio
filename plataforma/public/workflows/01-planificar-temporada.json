      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "valid-url",
              "leftValue": "={{ $json.studioUrl.startsWith(\"https://\") && $json.studioUrl.length > 8 && !$json.studioUrl.includes(\"?\") && !$json.studioUrl.includes(\"#\") && !$json.studioUrl.includes(\"@\") }}",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              },
              "rightValue": true
            },
            {
              "id": "valid-id",
              "leftValue": "={{ /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test($json.productionId) }}",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              },
              "rightValue": true
            }
          ]
        },
        "options": {}
