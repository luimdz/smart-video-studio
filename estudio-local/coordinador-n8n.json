    {
      "id": "44157658-c248-4b85-a18e-285f0fd9498f",
      "name": "¿Estado válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        224,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ /^[0-9a-f-]{36}$/i.test($json.body?.productionId ?? \"\") && Number.isInteger($json.body?.totalEpisodes) && $json.body.totalEpisodes >= 1 && $json.body.totalEpisodes <= 25 && [\"writtenEpisodes\",\"voicedEpisodes\",\"renderedEpisodes\"].every(k => Number.isInteger($json.body[k]) && $json.body[k] >= 0 && $json.body[k] <= $json.body.totalEpisodes) && [\"hasBible\",\"hasOutline\",\"correctionPending\",\"reviewPassed\"].every(k => typeof $json.body[k] === \"boolean\") }}",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              },
              "rightValue": true
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "897a1e7c-4830-4953-823f-81545cbee8c5",
      "name": "Decidir siguiente etapa",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "production",
              "name": "productionId",
              "type": "string",
              "value": "={{ $json.body.productionId }}"
            },
            {
              "id": "version",
              "name": "protocolVersion",
              "type": "number",
              "value": 1
            },
            {
              "id": "action",
              "name": "action",
              "type": "string",
              "value": "={{ !$json.body.hasBible ? \"bible\" : !$json.body.hasOutline ? \"outline\" : $json.body.writtenEpisodes < $json.body.totalEpisodes ? \"script\" : $json.body.correctionPending ? \"correct\" : !$json.body.reviewPassed ? \"review\" : $json.body.voicedEpisodes < $json.body.totalEpisodes ? \"voice\" : $json.body.renderedEpisodes < $json.body.totalEpisodes ? \"render\" : \"complete\" }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "15673a8d-5ff8-4168-8734-c0c0b6966bfc",
      "name": "Detener solicitud inválida",
